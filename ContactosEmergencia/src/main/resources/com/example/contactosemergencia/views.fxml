<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.contactos.controllers.AppController">
    <TextField fx:id="txtNombre" promptText="Nombre"/>
    <TextField fx:id="txtTelefono" promptText="Teléfono"/>
    <ComboBox fx:id="cbParentesco"/>

    <HBox spacing="5">
        <Button text="Agregar" onAction="#onAgregar"/>
        <Button text="Buscar" onAction="#onBuscar"/>
        <Button text="Actualizar" onAction="#onActualizar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
        <Button text="Limpiar" onAction="#onLimpiar"/>
    </HBox>

    <ListView fx:id="listView"/>
    <Label fx:id="lblMsg"/>

</VBox>
